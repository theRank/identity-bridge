{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "identity-bridge",
    "main": "src/runtimes/workers.ts",
    "compatibility_date": "2026-10-01",
    "workers_dev": false,
    "preview_urls": false,
    // Keep bridge logs; platform invocation logs are outside the bridge's no-personal-data guarantee.
    "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
    }
}
