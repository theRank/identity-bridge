{
    "name": "@therank/identity-bridge-server",
    "version": "0.0.0",
    "description": "Server SDK for identity-bridge: verify bridge access tokens and lifecycle events",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/theRank/identity-bridge.git",
        "directory": "packages/server"
    },
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p .",
        "prepack": "npm run build",
        "test:node": "node test-node/verify.mjs"
    },
    "dependencies": {
        "jose": "^6.2.17"
    },
    "publishConfig": {
        "access": "public"
    }
}
