{
    "compilerOptions": {
        "target": "es2017",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2017"],
        "types": [],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src"]
}
