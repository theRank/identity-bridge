{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        // Node runs these files by stripping their types, so they import each other by their .ts names
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true
    },
    "include": ["."],
    "exclude": []
}
